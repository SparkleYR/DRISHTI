# Backend service
DRISHTI_SERVICE_VERSION=0.1.0
DRISHTI_HOST=0.0.0.0
DRISHTI_PORT=8000
DRISHTI_LOG_LEVEL=INFO
DRISHTI_LOG_FILE=logs/drishti.log
DRISHTI_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Local-only persistence
DRISHTI_DATABASE_PATH=data/drishti.db
DRISHTI_EVIDENCE_DIR=data/evidence
DRISHTI_MAX_EVIDENCE_IMAGE_BYTES=5242880
DRISHTI_HAZARD_DUPLICATE_RADIUS=0.05
DRISHTI_HAZARD_DUPLICATE_WINDOW_SECONDS=900
DRISHTI_HAZARD_TEMPORARY_TTL_SECONDS=900
DRISHTI_HAZARD_PERSON_TTL_SECONDS=45

# Phase 7 local CPU OCR (English only)
DRISHTI_TESSERACT_COMMAND=.tools/Tesseract-OCR/tesseract.exe
DRISHTI_OCR_LANGUAGE=eng
DRISHTI_OCR_CONFIDENCE_THRESHOLD=0.65
DRISHTI_EXPLORE_MAX_IMAGE_WIDTH=2048
DRISHTI_EXPLORE_MAX_IMAGE_BYTES=8388608
DRISHTI_EXPLORE_MAX_IMAGE_PIXELS=8388608

# Approved local compute target
DRISHTI_COMPUTE_DEVICE=CUDA
DRISHTI_COMPUTE_DEVICE_NAME=NVIDIA GeForce RTX 4060 Laptop GPU

# Phase 2 local detector; the backend must never download weights at runtime
DRISHTI_MODELS_DIR=models
DRISHTI_DETECTOR_MODEL_PATH=models/detector/yolo11n.pt
DRISHTI_DETECTOR_CONFIDENCE_THRESHOLD=0.35
DRISHTI_DETECTOR_IMAGE_SIZE=640
# Phase 3 local semantic segmenter
DRISHTI_SEGMENTATION_MODEL_PATH=models/segmentation/segformer-b0-cityscapes
DRISHTI_SEGMENTATION_INPUT_HEIGHT=512
DRISHTI_SEGMENTATION_INPUT_WIDTH=1024
# Reserved for a later approved optional depth model; Phase 3 uses geometry fallback
DRISHTI_DEPTH_MODEL_PATH=models/depth/model.pt
DRISHTI_TRACK_IOU_THRESHOLD=0.20
DRISHTI_TRACK_CENTRE_DISTANCE_THRESHOLD=0.12
DRISHTI_TRACK_MAX_AGE_FRAMES=3
DRISHTI_APPROACH_CHANGE_THRESHOLD=0.05
DRISHTI_PROXIMITY_AREA_WEIGHT=0.55
DRISHTI_PROXIMITY_AREA_SCALE=0.50
DRISHTI_PROXIMITY_FAR_THRESHOLD=0.35
DRISHTI_PROXIMITY_MEDIUM_THRESHOLD=0.55
DRISHTI_PROXIMITY_NEAR_THRESHOLD=0.78
DRISHTI_CORRIDOR_HORIZON_Y=0.38
DRISHTI_CORRIDOR_TOP_HALF_WIDTH=0.08
DRISHTI_CORRIDOR_BOTTOM_HALF_WIDTH=0.42
DRISHTI_CORRIDOR_CLEAR_MARGIN=0.10
# Phase 8 indoor hall wall/dead-end evidence (SegFormer wall pixels)
DRISHTI_WALL_MIN_PIXEL_CONFIDENCE=0.60
DRISHTI_WALL_CENTRE_RATIO_THRESHOLD=0.35
DRISHTI_WALL_SIDE_RATIO_THRESHOLD=0.20

# Frozen initial engineering configuration; later phases must test/tune it
DRISHTI_RECOMMENDED_CAPTURE_FPS=2.0
DRISHTI_MAX_IMAGE_WIDTH=1280
DRISHTI_MAX_IMAGE_BYTES=5242880
DRISHTI_MAX_IMAGE_PIXELS=4194304
DRISHTI_MAX_MULTIPART_OVERHEAD_BYTES=262144
DRISHTI_MAX_RESULT_AGE_MS=3000
DRISHTI_RISK_WARN_ENTER=0.65
DRISHTI_RISK_WARN_EXIT=0.50
DRISHTI_RISK_WATCH_ENTER=0.25
DRISHTI_RISK_HIGH_ENTER=0.80
DRISHTI_RISK_WEIGHT_PATH_OVERLAP=0.30
DRISHTI_RISK_WEIGHT_PROXIMITY=0.25
DRISHTI_RISK_WEIGHT_APPROACH=0.20
DRISHTI_RISK_WEIGHT_CLASS_SEVERITY=0.15
DRISHTI_RISK_WEIGHT_CONFIDENCE=0.10
DRISHTI_RISK_CLASS_SEVERITIES={"person":0.55,"chair":0.75,"bag":0.45,"desk":0.80,"bicycle":0.80,"motorcycle":1.0,"car":0.95,"bus":1.0,"bench":0.65}
DRISHTI_RISK_CENTRE_BLOCK_THRESHOLD=0.45
DRISHTI_RISK_SIDE_BLOCK_THRESHOLD=0.45
DRISHTI_RISK_CRITICAL_PATH_OVERLAP=0.60
DRISHTI_RISK_CRITICAL_PROXIMITY=0.70
DRISHTI_RISK_CRITICAL_APPROACH=0.15
DRISHTI_ALERT_PERSISTENCE_FRAMES=2
DRISHTI_ALERT_CLEAR_FRAMES=3
DRISHTI_ALERT_COOLDOWN_SECONDS=3.0
DRISHTI_DECISION_MARGIN=0.10
