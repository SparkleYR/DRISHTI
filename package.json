{
  "name": "drishti",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:dashboard": "npm run build --workspace apps/dashboard",
    "config:mobile": "npm run config:check --workspace apps/mobile"
  },
  "engines": {
    "node": ">=24"
  }
}
