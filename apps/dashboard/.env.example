# Backend the dashboard polls. Defaults to loopback because the dashboard and
# the backend run on the same laptop (DRISHTI is local-only, AGENTS.md).
# Do not put a LAN IP here just to make the phone work: the phone's backend URL
# is configured separately in the Android client.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional. The Walk telemetry WebSocket base is derived from VITE_API_BASE_URL
# (http -> ws) and the dashboard discovers the live session id itself via
# GET /api/v1/walk/sessions/active. Set this only to serve telemetry from a
# different origin; do not append a session id, the dashboard adds the path.
# VITE_STREAM_WS_URL=ws://127.0.0.1:8000
